{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "export-manifest 1.0.0",
  "type": "object",
  "properties": {
    "exportVersion": {
      "const": "1.0.0"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "kind": {
      "enum": ["public-content", "workspace-backup"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "files": {
      "type": "array",
      "maxItems": 511,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 160,
            "pattern": "^(?:portfolio\\.json|backup\\.json|content/(?:site|projects|assets)\\.json|content/architectures/[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.json|assets/[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.(?:png|jpg|jpeg|webp|avif))$"
          },
          "byteSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10485760
          }
        },
        "required": ["path", "byteSize"],
        "additionalProperties": false
      }
    }
  },
  "required": ["exportVersion", "schemaVersion", "kind", "createdAt", "files"],
  "additionalProperties": false
}
