{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "포트폴리오 전시장 데이터 형식 1.0.0",
  "description": "구조 검사용 명세. ID 중복, 참조 관계와 자산 실물은 별도 검증한다.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "kind": {
      "enum": ["workspace", "public", "example"]
    },
    "site": {
      "$ref": "#/$defs/site"
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "architectures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/architecture"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "required": ["schemaVersion", "kind", "site", "projects", "architectures", "assets"],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "url": {
      "type": "string",
      "maxLength": 2048,
      "format": "uri",
      "pattern": "^https://[^\\s]+$"
    },
    "link": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 80,
          "minLength": 1,
          "pattern": "\\S"
        },
        "url": {
          "$ref": "#/$defs/url"
        }
      },
      "required": ["label", "url"],
      "additionalProperties": false
    },
    "month": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$"
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": ["code", "document", "author"]
        },
        "label": {
          "type": "string",
          "maxLength": 120,
          "minLength": 1,
          "pattern": "\\S"
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/url"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": ["kind", "label", "url", "note"],
      "additionalProperties": false
    },
    "site": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "object",
          "properties": {
            "displayName": {
              "type": "string",
              "maxLength": 40
            },
            "bio": {
              "type": "string",
              "maxLength": 2000
            },
            "avatarAssetId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/id"
                },
                {
                  "type": "null"
                }
              ]
            },
            "interests": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 60,
                "minLength": 1,
                "pattern": "\\S"
              },
              "uniqueItems": true
            },
            "links": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/link"
              }
            }
          },
          "required": ["displayName", "bio", "avatarAssetId", "interests", "links"],
          "additionalProperties": false
        },
        "exhibition": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 80
            },
            "description": {
              "type": "string",
              "maxLength": 300
            },
            "defaultView": {
              "enum": ["gallery", "exhibition"]
            },
            "projectOrder": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            }
          },
          "required": ["title", "description", "defaultView", "projectOrder"],
          "additionalProperties": false
        },
        "theme": {
          "type": "object",
          "properties": {
            "preset": {
              "enum": ["digital", "light"]
            },
            "logoAssetId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/id"
                },
                {
                  "type": "null"
                }
              ]
            },
            "faviconAssetId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/id"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["preset", "logoAssetId", "faviconAssetId"],
          "additionalProperties": false
        }
      },
      "required": ["profile", "exhibition", "theme"],
      "additionalProperties": false
    },
    "video": {
      "type": "object",
      "properties": {
        "provider": {
          "const": "youtube"
        },
        "videoId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{11}$"
        },
        "title": {
          "type": "string",
          "maxLength": 150,
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": ["provider", "videoId", "title"],
      "additionalProperties": false
    },
    "caseStudy": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "problem": {
          "type": "string",
          "maxLength": 20000
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "solution": {
          "type": "string",
          "maxLength": 20000
        },
        "outcome": {
          "type": "string",
          "maxLength": 20000
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      },
      "required": ["id", "title", "problem", "alternatives", "solution", "outcome", "evidence"],
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "slug": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "maxLength": 300
        },
        "genre": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 80,
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": ["draft", "published"]
        },
        "role": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120,
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "period": {
          "type": "object",
          "properties": {
            "start": {
              "anyOf": [
                {
                  "$ref": "#/$defs/month"
                },
                {
                  "type": "null"
                }
              ]
            },
            "end": {
              "anyOf": [
                {
                  "$ref": "#/$defs/month"
                },
                {
                  "type": "null"
                }
              ]
            },
            "ongoing": {
              "type": "boolean"
            }
          },
          "required": ["start", "end", "ongoing"],
          "additionalProperties": false
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "technologies": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "teamSize": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "media": {
          "type": "object",
          "properties": {
            "coverAssetId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/id"
                },
                {
                  "type": "null"
                }
              ]
            },
            "screenshotAssetIds": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "video": {
              "anyOf": [
                {
                  "$ref": "#/$defs/video"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["coverAssetId", "screenshotAssetIds", "video"],
          "additionalProperties": false
        },
        "contribution": {
          "type": "object",
          "properties": {
            "responsibilities": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 2000,
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "leadership": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 2000,
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "required": ["responsibilities", "leadership"],
          "additionalProperties": false
        },
        "overview": {
          "type": "string",
          "maxLength": 20000
        },
        "caseStudies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/caseStudy"
          }
        },
        "outcome": {
          "type": "string",
          "maxLength": 20000
        },
        "reflection": {
          "type": "string",
          "maxLength": 20000
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      },
      "required": [
        "id",
        "slug",
        "title",
        "summary",
        "genre",
        "status",
        "role",
        "period",
        "platforms",
        "technologies",
        "teamSize",
        "media",
        "contribution",
        "overview",
        "caseStudies",
        "outcome",
        "reflection",
        "links"
      ],
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "maxLength": 80,
          "minLength": 1,
          "pattern": "\\S"
        },
        "layer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      },
      "required": ["id", "label", "layer"],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "maxLength": 80
        },
        "groupId": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "parentId": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "responsibility": {
          "type": "string",
          "maxLength": 4000
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "decisions": {
          "type": "string",
          "maxLength": 4000
        },
        "contributionType": {
          "enum": ["direct", "shared", "team", "unknown"]
        },
        "contributionNote": {
          "type": "string",
          "maxLength": 2000
        },
        "relatedCaseIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "codeRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      },
      "required": [
        "id",
        "label",
        "groupId",
        "parentId",
        "responsibility",
        "inputs",
        "outputs",
        "decisions",
        "contributionType",
        "contributionNote",
        "relatedCaseIds",
        "codeRefs"
      ],
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/id"
        },
        "target": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": ["call", "data", "event", "dependency"]
        },
        "label": {
          "type": "string",
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": ["id", "source", "target", "type", "label", "description"],
      "additionalProperties": false
    },
    "architecture": {
      "type": "object",
      "properties": {
        "projectId": {
          "$ref": "#/$defs/id"
        },
        "verified": {
          "type": "boolean"
        },
        "revision": {
          "type": "object",
          "properties": {
            "label": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 120,
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reviewedAt": {
              "type": ["string", "null"],
              "format": "date"
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source"
              }
            }
          },
          "required": ["label", "reviewedAt", "sources"],
          "additionalProperties": false
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      },
      "required": ["projectId", "verified", "revision", "groups", "nodes", "edges"],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^assets/[a-z][a-z0-9-]*\\.(?:png|jpg|jpeg|webp|avif)$"
        },
        "mimeType": {
          "enum": ["image/png", "image/jpeg", "image/webp", "image/avif"]
        },
        "byteSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "alt": {
          "type": "string",
          "maxLength": 300,
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": ["id", "path", "mimeType", "byteSize", "width", "height", "alt"],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "public"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "site": {
            "properties": {
              "profile": {
                "properties": {
                  "displayName": {
                    "type": "string",
                    "maxLength": 40,
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "type": "object"
              },
              "exhibition": {
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 80,
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          "projects": {
            "items": {
              "properties": {
                "status": {
                  "const": "published"
                },
                "title": {
                  "type": "string",
                  "maxLength": 120,
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "summary": {
                  "type": "string",
                  "maxLength": 300,
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "caseStudies": {
                  "items": {
                    "properties": {
                      "title": {
                        "type": "string",
                        "maxLength": 120,
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "problem": {
                        "type": "string",
                        "maxLength": 20000,
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "solution": {
                        "type": "string",
                        "maxLength": 20000,
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "outcome": {
                        "type": "string",
                        "maxLength": 20000,
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "architectures": {
            "items": {
              "properties": {
                "verified": {
                  "const": true
                },
                "revision": {
                  "properties": {
                    "reviewedAt": {
                      "type": "string",
                      "format": "date"
                    },
                    "sources": {
                      "minItems": 1,
                      "type": "array"
                    }
                  },
                  "type": "object"
                },
                "nodes": {
                  "minItems": 1,
                  "items": {
                    "properties": {
                      "label": {
                        "type": "string",
                        "maxLength": 80,
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "responsibility": {
                        "type": "string",
                        "maxLength": 4000,
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
                "edges": {
                  "items": {
                    "properties": {
                      "label": {
                        "type": "string",
                        "maxLength": 80,
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  ]
}
